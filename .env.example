# ==========================================
# Tech Market Data Pipeline - Environment Variables
# ==========================================
# COPY THIS FILE TO .env AND FILL IN YOUR CREDENTIALS:
# cp .env.example .env

# AWS Credentials (Obtained from AWS IAM Console)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_DEFAULT_REGION=us-east-1

# S3 Data Lake Configuration
S3_BUCKET_NAME=tech-market-data-lake-raw
S3_BRONZE_PREFIX=bronze/market_data

# Tickers to Extract (Comma-separated)
TARGET_TICKERS=NVDA,TSM,MSFT

# Extraction Period & Interval
EXTRACTION_PERIOD=1mo
EXTRACTION_INTERVAL=1d

# Storage Format: 'parquet' (recommended) or 'csv'
STORAGE_FORMAT=parquet

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ==========================================
# Database Credentials (PostgreSQL / Gold Layer)
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=market_data
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/market_data
